{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("apt\\socialfeeds\\assetbundles\\socialfeeds\\SocialFeedsAsset") %}

{% if settings.facebook %}
    <fieldset id="tab-facebook">
        <h2>Facebook</h2>
        <p>
            {{ 'To find your page id, follow this recipe:'|t('apt-social-feeds') }}<br />
            <a href="https://findmyfbid.com/" target="_blank" rel="nofollow noreferrer noopener">Find your Facebook ID</a>
        </p>
        {{ forms.LightswitchField({
            label: 'Activate feed'|t('apt-social-feeds'),
            id: 'facebook-on',
            name: 'facebookOn',
            value: true,
            on: settings['facebookOn'],
            errors: settings.getErrors('facebookOn'),
        }) }}
        {{ forms.textField({
            label: 'App Id'|t('apt-social-feeds'),
            id: 'facebook-app-id',
            name: 'facebookAppId',
            value: settings['facebookAppId'],
            errors: settings.getErrors('facebookAppId'),
        }) }}
        {{ forms.textField({
            label: 'App secret'|t('apt-social-feeds'),
            id: 'facebook-app-secret',
            name: 'facebookAppSecret',
            value: settings['facebookAppSecret'],
            errors: settings.getErrors('facebookAppSecret'),
        }) }}
        {{ forms.textField({
            label: 'Page id'|t('apt-social-feeds'),
            id: 'facebook-page-id',
            name: 'facebookPageId',
            value: settings['facebookPageId'],
            errors: settings.getErrors('facebookPageId'),
        }) }}
        <div class="field">
            <strong>{{ 'Url to the feed:'|t('apt-social-feeds') }}</strong> <a href="{{ siteUrl }}actions/apt-social-feeds/facebook" target="_blank" rel="nofollow noreferrer noopener">{{ siteUrl }}actions/apt-social-feeds/facebook</a>
            <br />
            <br />
            <h2>{{ 'Feed:'|t('apt-social-feeds') }}</h2>
            <p>{{ 'Default limit of feed is 6. Add ?limit={your limit} to the query string to load more'|t('apt-social-feeds') }}</p>
            <p>
                <a href="{{ siteUrl }}actions/apt-social-feeds/facebook?limit=8" target="_blank" rel="nofollow noreferrer noopener">{{ siteUrl }}actions/apt-social-feeds/facebook?limit=8</a>
            </p>
            <h3>{{ 'Current feed (limit: 3):'|t('apt-social-feeds') }}</h3>
            <div class="feed">
<pre><code>{{ plugin.facebook.feed(3)|json_encode|json_prettify }}</code></pre>
            </div>
        </div>
        {% if
            settings.hasErrors('facebookOn') or
            settings.hasErrors('facebookAccessToken') or
            settings.hasErrors('facebookPageId')
        %}
            <script>
                (function() {
                    var tabs = document.getElementById('tabs');
                    var tab = tabs.querySelector('a[href="#settings-tab-facebook"]');
                    if (tab) {
                        tab.click();
                    }
                })();
            </script>
        {% endif %}
    </fieldset>
{% endif %}

{% if settings.youtube %}
    <fieldset id="tab-youtube" class="hidden">
        <h2>Youtube</h2>
        <p>
            {{ 'To obtain a Youtube Api key, follow this recipe:'|t('apt-social-feeds') }}<br />
            <a href="https://developers.google.com/youtube/registering_an_application" target="_blank" rel="nofollow noreferrer noopener">YouTube Data API</a>
        </p>
        <p>
            {{ 'Log on to your google account and create api key here'|t('apt-social-feeds') }}<br />
            <a href="https://console.developers.google.com/apis/dashboard" target="_blank" rel="nofollow noreferrer noopener">Google Api Console</a>
        </p>
        {{ forms.LightswitchField({
            label: 'Activate feed'|t('apt-social-feeds'),
            id: 'youtube-on',
            name: 'youtubeOn',
            value: true,
            on: settings['youtubeOn'],
            errors: settings.getErrors('youtubeOn'),
        }) }}
        {{ forms.textField({
            label: 'Api Key'|t('apt-social-feeds'),
            id: 'youtube-key',
            name: 'youtubeKey',
            value: settings['youtubeKey'],
            errors: settings.getErrors('youtubeKey'),
        }) }}
        {{ forms.selectField({
            label: 'Type'|t('apt-social-feeds'),
            instructions: 'Do you have a playlist id or a channel id?'|t('apt-social-feeds'),
            id: 'youtube-type',
            name: 'youtubeType',
            options: [
                { label: 'Playlist', value: 'playlist' },
                { label: 'Channel', value: 'channel' },
            ],
            value: settings['youtubeType'],
            errors: settings.getErrors('youtubeType'),
        }) }}
        <div id="youtube-playlist-container" class="field {% if settings['youtubeType'] != 'playlist' %}hidden{% endif %}">
            {{ forms.textField({
                label: 'Playlist id'|t('apt-social-feeds'),
                id: 'youtube-playlist',
                name: 'youtubePlaylist',
                value: settings['youtubePlaylist'],
                errors: settings.getErrors('youtubePlaylist'),
            }) }}
        </div>

        <div id="youtube-channel-container" class="field {% if settings['youtubeType'] != 'channel' %}hidden{% endif %}">
            {{ forms.textField({
                label: 'Channel'|t('apt-social-feeds'),
                instructions: 'Enter some setting here.',
                id: 'youtube-channel',
                name: 'youtubeChannel',
                value: settings['youtubeChannel'],
                errors: settings.getErrors('youtubeChannel'),
            }) }}
        </div>
        <div class="field">
            <strong>{{ 'Url to the feed:'|t('apt-social-feeds') }}</strong> <a href="{{ siteUrl }}actions/apt-social-feeds/youtube" target="_blank" rel="nofollow noreferrer noopener">{{ siteUrl }}actions/apt-social-feeds/youtube</a>
            <br />
            <br />
            <h2>{{ 'Feed:'|t('apt-social-feeds') }}</h2>
            <p>{{ 'Default limit of feed is 6. Add ?limit={your limit} to the query string to load more'|t('apt-social-feeds') }}</p>
            <p>
                <a href="{{ siteUrl }}actions/apt-social-feeds/youtube?limit=8" target="_blank" rel="nofollow noreferrer noopener">{{ siteUrl }}actions/apt-social-feeds/youtube?limit=8</a>
            </p>
            <h3>{{ 'Current feed (limit: 3):'|t('apt-social-feeds') }}</h3>
            <div class="feed">
<pre><code>{{ plugin.youtube.feed(3)|json_encode|json_prettify }}</code></pre>
            </div>
        </div>
        <script>
            (function() {
                var type = document.getElementById('settings-youtube-type');
                var playlist = document.getElementById('settings-youtube-playlist-container');
                var channel = document.getElementById('settings-youtube-channel-container');

                type.addEventListener('change', function(e) {
                    if (e.target.value === 'playlist') {
                        playlist.classList.remove('hidden');
                        channel.classList.add('hidden');
                    } else {
                        playlist.classList.add('hidden');
                        channel.classList.remove('hidden');
                    }
                });
            })();
        </script>

        {% if
            settings.hasErrors('youtubeOn') or
            settings.hasErrors('youtubeKey') or
            settings.hasErrors('youtubeType') or
            settings.hasErrors('youtubePlaylist') or
            settings.hasErrors('youtubeChannel')
        %}
            <script>
                (function() {
                    var tabs = document.getElementById('tabs');
                    var tab = tabs.querySelector('a[href="#settings-tab-youtube"]');
                    if (tab) {
                        tab.click();
                    }
                })();
            </script>
        {% endif %}
    </fieldset>
{% endif %}

