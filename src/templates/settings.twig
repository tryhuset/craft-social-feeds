{% import "_includes/forms" as forms %}

{% do view.registerAssetBundle("apt\\socialfeeds\\assetbundles\\socialfeeds\\SocialFeedsAsset") %}

<fieldset id="tab-facebook">
    <h2>Facebook</h2>
    {{ forms.LightswitchField({
        label: 'On'|t,
        instructions: 'Enter some setting here.',
        id: 'facebook-on',
        name: 'facebookOn',
        value: true,
        on: settings['facebookOn'],
        errors: settings.getErrors('facebookOn'),
    }) }}
    {{ forms.textField({
        label: 'Access token',
        instructions: 'Enter some setting here.',
        id: 'facebook-access-token',
        name: 'facebookAccessToken',
        value: settings['facebookAccessToken'],
        errors: settings.getErrors('facebookAccessToken'),
    }) }}
    {{ forms.textField({
        label: 'Page id',
        instructions: 'Enter some setting here.',
        id: 'facebook-page-id',
        name: 'facebookPageId',
        value: settings['facebookPageId'],
        errors: settings.getErrors('facebookPageId'),
    }) }}
    {% if
        settings.hasErrors('facebookOn') or
        settings.hasErrors('facebookAccessToken') or
        settings.hasErrors('facebookPageId')
    %}
        <script>
            (function() {
                var tabs = document.getElementById('tabs');
                var tab = tabs.querySelector('a[href="#settings-tab-facebook"]');
                if (tab) {
                    tab.click();
                }
            })();
        </script>
    {% endif %}
</fieldset>

