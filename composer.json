{
    "name": "apt/craft-social-feeds",
    "description": "Utilizes json api to get latest social feeds",
    "type": "craft-plugin",
    "version": "2.0.0",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "social feeds"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Sømoen",
            "homepage": "https://apt.no/"
        }
    ],
    "require": {
        "craftcms/cms": "3.*",
        "guzzlehttp/oauth-subscriber": "^0.3",
        "camspiers/json-pretty": "^1.0",
        "elvanto/litemoji": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "6.5.8"
    },
    "autoload": {
        "psr-4": {
          "apt\\socialfeeds\\": "src/"
        }
    },
    "extra": {
        "name": "Social feeds",
        "handle": "apt-social-feeds",
        "hasCpSettings": true,
        "hasCpSection": false,
        "class": "apt\\socialfeeds\\SocialFeeds"
    }
}
