{
  "name": "apt/craft-social-feeds",
  "description": "Utilizes json api to get latest social feeds",
  "type": "craft-plugin",
  "version": "4.1.1",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "social feeds"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Thomas Sømoen",
      "homepage": "https://try.no/"
    }
  ],
  "require": {
    "craftcms/cms": "^5.9.18",
    "guzzlehttp/oauth-subscriber": "^0.8.1",
    "php": "^8.0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10",
    "craftcms/rector": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "apt\\socialfeeds\\": "src/"
    }
  },
  "extra": {
    "name": "Social feeds",
    "handle": "apt-social-feeds",
    "hasCpSettings": true,
    "hasCpSection": false,
    "class": "apt\\socialfeeds\\SocialFeeds"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}